{
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "npx vercel deploy --prod",
    "dev": "npx livery public",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "stylelint --fix '**/*.{html,css,js}'",
    "lint:js": "vp check --fix '**/*.{html,css,js}'",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "postcss-html": "^2.0.0",
    "postcss-styled-syntax": "^0.7.2",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
